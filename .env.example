# Origine Prometheus, sans /api/v1. Laisser vide en développement pour utiliser
# automatiquement le mock local (npm run dev:mock).
PROMETHEUS_URL=

# Ports du serveur web et du mock local.
PORT=3000
MOCK_PORT=9090

# Scénario déterministe du mock : nominal, empty, stale, partial, thresholds,
# zero-weight, longnames.
MOCK_SCENARIO=nominal

# Seuils de fraîcheur affichés (secondes).
COLLECTION_STALE_SECONDS=900
WEIGHT_STALE_SECONDS=600
