{
  "name": "dashboard-infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tableau de bord des abonnements IA et de la consommation, aliment\u00e9 par Prometheus.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "concurrently -k -n prometheus,app -c cyan,magenta \"npm:mock\" \"npm:dev\"",
    "mock": "tsx scripts/mock-prometheus.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "preview": "npm run build && npm run start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.10.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "nitro": "3.0.261103-rc",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
